# データ収集元 (youtube-analytics リポジトリの公開DBファイル)
# 既定値はコード内に設定済みのため、通常は変更不要（未設定でも動作する）
# https://github.com/oyasusan/youtube-analytics
# YOUTUBE_ANALYTICS_DB_URL=https://raw.githubusercontent.com/oyasusan/youtube-analytics/main/data/youtube_analytics.db

# 任意: src/collectors/youtube.py でYouTube Data APIを直接叩く場合のみ使用。
# 既定のパイプライン(src/main.py)では不要。
# YOUTUBE_API_KEY=your_youtube_api_key_here
# YOUTUBE_CHANNEL_ID=your_target_channel_id_here

# Groq API (OpenAI SDK互換, https://api.groq.com/openai/v1)
GROQ_API_KEY=your_groq_api_key_here

# 任意: src/video/capcut_draft.py がCapCut Desktopの下書き保存フォルダを
# OS標準パスから自動検出できない場合のみ設定する。
# Windows既定: %LOCALAPPDATA%\CapCut\User Data\Projects\com.lveditor.draft
# macOS既定:   ~/Movies/CapCut/User Data/Projects/com.lveditor.draft
# CAPCUT_DRAFT_ROOT=/path/to/CapCut/User Data/Projects/com.lveditor.draft

# src/video/generator.py のナレーション音声合成に使うVOICEVOX ENGINE。
# 事前にローカルで起動しておくこと（例: `docker run -p 50021:50021 voicevox/voicevox_engine:cpu-latest`）。
# 未設定時は既定値 http://127.0.0.1:50021 / 話者ID=2（四国めたん・ノーマル）を使う。
# 話者IDは起動中のエンジンの `GET /speakers` で一覧を確認できる。
# VOICEVOX_ENGINE_URL=http://127.0.0.1:50021
# VOICEVOX_SPEAKER_ID=2
